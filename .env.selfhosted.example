KB_SERVICE_NAME=hybrid-kb-mcp
KB_HTTP_HOST=0.0.0.0
KB_HTTP_PORT=8080
KB_AUTH_MODE=strict
KB_TRANSPORT_SECURITY_ENABLED=true
# Adjust to your reverse proxy / frontend origins and hosts.
KB_TRANSPORT_ALLOWED_HOSTS=mcp.internal.example.com:443,127.0.0.1:*,localhost:*
KB_TRANSPORT_ALLOWED_ORIGINS=https://app.example.com,https://ops.example.com

KB_VECTOR_BACKEND=qdrant
KB_GRAPH_BACKEND=neo4j
KB_METADATA_BACKEND=sqlite
KB_METADATA_DSN=sqlite:///./.kb_mcp/metadata.db
# Recommended for multi-user self-hosted:
# KB_METADATA_BACKEND=postgres
# KB_METADATA_DSN=postgresql+psycopg://kb_user:<strong-password>@postgres:5432/kb_metadata

KB_MCP_DATA_PATH=./.docker-data/mcp
KB_QDRANT_URL=http://qdrant:6333
KB_QDRANT_STORAGE_PATH=./.docker-data/qdrant
KB_QDRANT_COLLECTION_CHUNKS=kb_chunks
KB_QDRANT_COLLECTION_MEMORY=kb_memory

KB_NEO4J_URI=bolt://neo4j:7687
KB_NEO4J_USER=neo4j
KB_NEO4J_PASSWORD=replace-with-strong-neo4j-password
KB_NEO4J_DATABASE=neo4j
KB_NEO4J_DATA_PATH=./.docker-data/neo4j/data
NEO4J_AUTH=neo4j/replace-with-strong-neo4j-password

# Required in strict mode; generate a strong secret (32+ chars).
KB_JWT_SECRET=replace-with-generated-strong-32plus-char-secret
KB_JWT_ALGORITHM=HS256

# OIDC/JWKS (only for KB_AUTH_MODE=strict_oauth)
KB_OAUTH_ISSUER_URL=
KB_OAUTH_AUDIENCE=
KB_OAUTH_JWKS_URL=
KB_OAUTH_REQUIRED_SCOPES=

KB_EMBEDDING_PROVIDER=local
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_EMBEDDING_MODEL_REVISION=
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_DIMENSIONS=384
KB_EMBEDDING_BATCH_SIZE=32
KB_EMBEDDING_CACHE_ENABLED=true
KB_EMBEDDING_CACHE_MAX_ITEMS=4096

KB_FUSION_MODE=linear
KB_CHUNKING_MODE=char
KB_GRAPH_ENFORCE_OBJECT_ACL=true

KB_OTEL_ENABLED=false
KB_OTEL_EXPORTER_OTLP_ENDPOINT=
KB_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
KB_PROMETHEUS_ENABLED=false
KB_PROMETHEUS_PORT=9464

KB_AUTO_INGEST_ENABLED=true
KB_AUTO_INGEST_ROOTS=/app/kb_mcp
KB_AUTO_INGEST_WORKSPACE_ID=w1
KB_AUTO_INGEST_ACL_SUBJECT=u1
KB_AUTO_INGEST_INTERVAL_S=900
KB_AUTO_INGEST_RUN_ON_START=true
KB_AUTO_INGEST_FULL_INTERVAL_CYCLES=8
KB_AUTO_INGEST_GIT_SINCE_REF=HEAD~1
KB_AUTO_INGEST_RETRY_ATTEMPTS=3
KB_AUTO_INGEST_RETRY_BACKOFF_S=1.5

KB_DENY_BY_DEFAULT=true
KB_MEMORY_CONFIDENCE_THRESHOLD=0.75

# Docker self-hosted publish behavior (MCP only by default; DB ports remain internal).
KB_MCP_PUBLISH_HOST=127.0.0.1
# Optional Postgres service (docker-compose.selfhosted.yml --profile postgres)
KB_POSTGRES_DB=kb_metadata
KB_POSTGRES_USER=kb_user
KB_POSTGRES_PASSWORD=replace-with-strong-postgres-password
KB_POSTGRES_STORAGE_PATH=./.docker-data/postgres
