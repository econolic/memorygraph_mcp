{
  "policy_version": "2026-02-19",
  "description": "Runtime policy for MCP tool orchestration in Hybrid KB MCP.",
  "router_contract": {
    "primary_tool": "kb.route",
    "strategy": "router_first_with_compatibility_fallback",
    "route_output_fields": [
      "intent",
      "route_reason",
      "recommended_tools",
      "execution_plan"
    ],
    "client_execution_rules": [
      "Call kb.route first when available",
      "Execute execution_plan in order",
      "Use recommended_tools for explain/debug, not as authoritative execution order",
      "Fallback to direct tool selection if kb.route is unavailable"
    ]
  },
  "decision_schema": {
    "intent": "fact_lookup|relation_impact|explainability|memory_context|memory_delete",
    "auth_mode": "dual|strict|strict_oauth",
    "identity_source": "authorization_header|payload_jwt|legacy_acl|anonymous",
    "router_used": true,
    "recommended_tools": ["kb.search"],
    "execution_plan": [
      {
        "name": "kb.search",
        "reason": "Need evidence with citations"
      }
    ],
    "tools": [
      {
        "name": "kb.search",
        "reason": "Need evidence with citations"
      }
    ],
    "requires_citations": true,
    "fallback": {
      "kb_route_unavailable": "compatibility_manual_tool_selection",
      "graph_unavailable": "vector_only_with_disclaimer",
      "graph_nonzero_false_on_relation_query": "state_low_graph_confidence"
    }
  },
  "intent_rules": [
    {
      "intent": "fact_lookup",
      "if_query_contains_any": ["what is", "where documented", "source", "citation"],
      "tools": ["kb.search"],
      "mode": "hybrid"
    },
    {
      "intent": "relation_impact",
      "if_query_contains_any": ["dependency", "impact", "who uses", "path", "chain"],
      "tools": ["kb.search", "kb.graph_expand"],
      "mode": "hybrid"
    },
    {
      "intent": "explainability",
      "if_query_contains_any": ["why relevant", "explain relevance", "why this result"],
      "tools": ["kb.search", "kb.explain"],
      "mode": "hybrid"
    },
    {
      "intent": "memory_context",
      "if_query_contains_any": ["what did we decide", "my context", "remember", "previous session"],
      "tools": ["kb.memory.search", "kb.search"],
      "mode": "hybrid"
    },
    {
      "intent": "memory_delete",
      "if_query_contains_any": ["delete memory", "forget everything", "remove all memory"],
      "tools": ["kb.memory.delete"],
      "mode": "hybrid"
    }
  ],
  "memory_write_policy": {
    "tool": "kb.memory.upsert",
    "required_fields": ["type", "text", "confidence", "citations"],
    "constraints": {
      "min_confidence": 0.75,
      "citations_required": true
    }
  },
  "system_prompt_template": "You are an MCP-aware assistant. Detect intent first, call tools before answering checkable claims, enforce citations, and never fabricate sources."
}
