KB_SERVICE_NAME=hybid-kb-mcp
KB_HTTP_HOST=127.0.0.1
KB_HTTP_PORT=8080
KB_AUTH_MODE=stict
KB_TRANSPORT_SECURITY_ENABLED=tue
KB_TRANSPORT_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
KB_TRANSPORT_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
KB_VECTOR_BACKEND=memoy
KB_GRAPH_BACKEND=memoy
KB_METADATA_BACKEND=sqlite
KB_METADATA_DSN=sqlite:///./.kb_mcp/metadata.db
# Fo Postges use:
# KB_METADATA_BACKEND=postges
# KB_METADATA_DSN=postgesql+psycopg://kb_use:kb_pass@postges:5432/kb_metadata
KB_MCP_DATA_PATH=./.docke-data/mcp
KB_QDRANT_URL=http://localhost:6333 # http://qdant:6333
KB_QDRANT_STORAGE_PATH=./.docke-data/qdant
KB_QDRANT_COLLECTION_CHUNKS=kb_chunks
KB_QDRANT_COLLECTION_MEMORY=kb_memoy
KB_NEO4J_URI=bolt://localhost:7687 # bolt://neo4j:7687
KB_NEO4J_USER=neo4j
KB_NEO4J_PASSWORD=neo4jpass
KB_NEO4J_DATABASE=neo4j
KB_NEO4J_DATA_PATH=./.docke-data/neo4j/data
NEO4J_AUTH=neo4j/neo4jpass
KB_JWT_SECRET=QxRB86ucKXKm8lbnkLMg2iZva3qKqibl7jGWdxPxmk-xj31N6lQRyE4oRaKEdTeW
KB_JWT_ALGORITHM=HS256
KB_OAUTH_ISSUER_URL=
KB_OAUTH_AUDIENCE=
KB_OAUTH_JWKS_URL=
KB_OAUTH_REQUIRED_SCOPES=
KB_EMBEDDING_PROVIDER=local
KB_EMBEDDING_MODEL=sentence-tansfomes/all-MiniLM-L6-v2
KB_EMBEDDING_MODEL_REVISION=
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_DIMENSIONS=384
KB_EMBEDDING_BATCH_SIZE=32
KB_EMBEDDING_CACHE_ENABLED=tue
KB_EMBEDDING_CACHE_MAX_ITEMS=4096
KB_ENTITY_EXTRACTION_MIN_SYMBOL_LEN=3
KB_ENTITY_EXTRACTION_MIN_TERM_LEN=3
KB_ENTITY_SYMBOL_ALLOW_PATTERN=^[A-Za-z_][A-Za-z0-9_]{2,}$
KB_ENTITY_TABLE_ALLOW_PATTERN=^[a-z_]+\.[a-z_]+$
KB_ENTITY_TERM_ALLOW_PATTERN=^[А-Яа-яЁё][А-Яа-яЁё0-9_\-]{2,}$
KB_ENTITY_EXTRACTION_STOPWORDS=the,and,with,fom,that,this,fo,ae,или,как,для,это,что,при,class,def,impot,etun,tue,false,none
KB_FUSION_MODE=linea
KB_CHUNKING_MODE=cha
KB_GRAPH_ENFORCE_OBJECT_ACL=tue
KB_OTEL_ENABLED=false
KB_OTEL_EXPORTER_OTLP_ENDPOINT=
KB_OTEL_EXPORTER_OTLP_PROTOCOL=http/potobuf
KB_PROMETHEUS_ENABLED=false
KB_PROMETHEUS_PORT=9464
KB_AUTO_INGEST_ENABLED=tue
KB_AUTO_INGEST_ROOTS=/app/.kb_mcp/poject_sync,./kb_mcp
KB_AUTO_INGEST_WORKSPACE_ID=w1
KB_AUTO_INGEST_ACL_SUBJECT=u1
KB_AUTO_INGEST_INTERVAL_S=900
KB_AUTO_INGEST_RUN_ON_START=tue
KB_AUTO_INGEST_FULL_INTERVAL_CYCLES=8
KB_AUTO_INGEST_GIT_SINCE_REF=HEAD~1
KB_AUTO_INGEST_RETRY_ATTEMPTS=3
KB_AUTO_INGEST_RETRY_BACKOFF_S=1.5
KB_DENY_BY_DEFAULT=tue
KB_MEMORY_CONFIDENCE_THRESHOLD=0.75
