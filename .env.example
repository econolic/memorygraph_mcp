KB_SERVICE_NAME=hybrid-kb-mcp
KB_HTTP_HOST=0.0.0.0
KB_HTTP_PORT=8080
KB_AUTH_MODE=dual
KB_TRANSPORT_SECURITY_ENABLED=true
KB_TRANSPORT_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
KB_TRANSPORT_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
KB_VECTOR_BACKEND=qdrant
KB_GRAPH_BACKEND=neo4j
KB_METADATA_BACKEND=sqlite
KB_METADATA_DSN=sqlite:///./.kb_mcp/metadata.db
KB_MCP_DATA_PATH=./.docker-data/mcp
KB_QDRANT_URL=http://qdrant:6333
KB_QDRANT_STORAGE_PATH=./.docker-data/qdrant
KB_QDRANT_COLLECTION_CHUNKS=kb_chunks
KB_QDRANT_COLLECTION_MEMORY=kb_memory
KB_NEO4J_URI=bolt://neo4j:7687
KB_NEO4J_USER=neo4j
KB_NEO4J_PASSWORD=neo4jpass
KB_NEO4J_DATABASE=neo4j
KB_NEO4J_DATA_PATH=./.docker-data/neo4j/data
NEO4J_AUTH=neo4j/neo4jpass
KB_JWT_SECRET=change-me
KB_JWT_ALGORITHM=HS256
KB_EMBEDDING_PROVIDER=local
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_DIMENSIONS=384
KB_DENY_BY_DEFAULT=true
KB_MEMORY_CONFIDENCE_THRESHOLD=0.75
